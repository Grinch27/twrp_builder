+			length <= offset - start || length > size - start ||
+			buf[start + length - 1] != '\n')
+			goto invalid;
+		const char *record = buf + offset;
+		size_t remaining = start + length - 1 - offset;
+		if (remaining >= CAPABILITIES_TAG_LEN &&
+			memcmp(record, CAPABILITIES_TAG, CAPABILITIES_TAG_LEN) == 0) {
+			if (remaining != CAPABILITIES_TAG_LEN + sizeof(struct vfs_cap_data) || t->th_buf.has_cap_data)
+				goto invalid;
+			memcpy(&t->th_buf.cap_data, record + CAPABILITIES_TAG_LEN, sizeof(struct vfs_cap_data));
+			t->th_buf.has_cap_data = 1;
+		} else if (remaining >= SELINUX_TAG_LEN && memcmp(record, SELINUX_TAG, SELINUX_TAG_LEN) == 0) {
+			size_t count = remaining - SELINUX_TAG_LEN;
