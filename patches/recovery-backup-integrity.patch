+bool TWPartition::Validate_Restore_Archive(const string& Folder) {
+	PartitionSettings settings = {};
+	settings.Backup_Folder = Folder;
+	settings.Part = this;
+	settings.PM_Method = PM_RESTORE;
+	settings.adbbackup = false;
+	string type = Get_Restore_File_System(&settings);
+	if (Is_Image(type))
+		return true; // Raw image size/digest checks retain their existing separate path.
+	if (!Is_File_System(type))
+		return false;
+	ProgressTracking progress(0);
+	settings.progress = &progress;
+	twrpTar tar;
+	tar.part_settings = &settings;
+	tar.setdir(Backup_Path);
+	tar.setfn(Folder + "/" + Backup_FileName);
+	tar.backup_name = Backup_Name;
+	tar.partition_name = Backup_Name;
+	tar.backup_folder = Folder;
+#ifndef TW_EXCLUDE_ENCRYPTED_BACKUPS
+	string password;
+	DataManager::GetValue("tw_restore_password", password);
+	if (!password.empty())
+		tar.setpassword(password);
+#endif
+	return tar.validateTarFork() == 0;
 }
 
