+{
+	size_t offset = 0;
+	while (offset < size) {
+		size_t start = offset, length = 0;
+		while (offset < size && buf[offset] >= '0' && buf[offset] <= '9') {
+			size_t digit = buf[offset++] - '0';
+			if (length > size / 10 || length * 10 + digit > size)
+				goto invalid;
+			length = length * 10 + digit;
+		}
