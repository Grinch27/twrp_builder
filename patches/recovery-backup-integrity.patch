+/* Normalize a legacy tar name lexically, retaining its selected partition boundary. */
+static int
+tar_validation_path(const char *prefix, const char *name, const char *root, char *out)
+{
+	char input[MAXPATHLEN];
+	if (!root || root[0] != '/' || !prefix || !name || (prefix[0] && prefix[0] != '/'))
+		return -1;
+	int count = snprintf(input, sizeof(input), "%s/%s", prefix, name);
+	if (count < 0 || (size_t)count >= sizeof(input))
+		return -1;
+	size_t read = 0, written = 0;
+	while (input[read]) {
+		while (input[read] == '/') ++read;
+		if (!input[read]) break;
+		size_t start = read;
+		while (input[read] && input[read] != '/') ++read;
+		size_t length = read - start;
+		if ((length == 1 && input[start] == '.') ||
+			(length == 2 && input[start] == '.' && input[start + 1] == '.'))
+			return -1;
+		if (written + 1 + length >= MAXPATHLEN)
+			return -1;
+		out[written++] = '/';
+		memcpy(out + written, input + start, length);
+		written += length;
+	}
+	if (!written) out[written++] = '/';
+	out[written] = 0;
+	size_t length = strlen(root);
+	while (length > 1 && root[length - 1] == '/') --length;
+	if (length == 1 && root[0] == '/') return 0;
+	return strncmp(out, root, length) == 0 && (out[length] == 0 || out[length] == '/') ? 0 : -1;
+}
+
+/* Read and validate headers/payloads only. Never create directories, files or policies. */
+int
+tar_validate_all(TAR *t, const char *prefix, const char *root)
+{
+	int result, entries = 0;
+	char path[MAXPATHLEN];
+	while ((result = th_read(t)) == 0) {
+		if (tar_validation_path(prefix, th_get_pathname(t), root, path) != 0) {
+			errno = EINVAL;
+			return -1;
+		}
+#ifdef USE_FSCRYPT
+		if (t->th_buf.fep) {
+			fscrypt_policy expected = *t->th_buf.fep, actual;
+			int size = fscrypt_policy_size(&expected);
+			int descriptor_size = get_policy_size(&expected, false);
+			uint8_t binary[sizeof(fscrypt_policy)] = {0};
+			uint8_t *descriptor = get_policy_descriptor(&expected);
+			if (!TH_ISDIR(t) || !size || !descriptor || !descriptor_size ||
+				descriptor_size > (int)sizeof(binary) || !lookup_ref_tar(&expected, binary)) {
+				errno = ENOKEY;
+				return -1;
+			}
+			memcpy(descriptor, binary, descriptor_size);
+			if (fscrypt_policy_get_struct(path, &actual)) {
+				if (fscrypt_policy_size(&actual) != size ||
+					memcmp(get_policy(&actual), get_policy(&expected), size) != 0) {
+					errno = EEXIST;
+					return -1;
+				}
+			} else if (errno != ENODATA && errno != ENOENT) {
+				return -1;
+			}
+		} else if (TH_ISDIR(t) && (t->options & TAR_REQUIRE_FSCRYPT_POL)) {
+			fscrypt_policy actual;
+			if (fscrypt_policy_get_struct(path, &actual) || (errno != ENODATA && errno != ENOENT)) {
+				errno = EINVAL;
+				return -1;
+			}
+		}
+#endif
+		if (TH_ISREG(t) && tar_skip_regfile(t) != 0)
+			return -1;
+		++entries;
+	}
+	return result == 1 && entries ? 0 : -1;
+}
