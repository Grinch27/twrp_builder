+TWPartition* TWPartitionManager::Resolve_Partition_Path(const string& Path, string* Matched_Path) {
+	if (Matched_Path)
+		Matched_Path->clear();
+	if (Path.empty())
+		return NULL;
+	string query = Path[0] == '/' ? Path : "/" + Path;
+	// Ownership is lexical. Do not follow links or resolve parent traversal.
+	std::istringstream components(query);
+	string component;
+	while (std::getline(components, component, '/')) {
+		if (component == "." || component == "..")
+			return NULL;
+	}
+	if (query == "/system" || query.compare(0, 8, "/system/") == 0)
+		query = Get_Android_Root_Path() + query.substr(7);
+
+	TWPartition* best = NULL;
+	size_t best_length = 0;
+	bool best_is_mount = false;
+	for (auto part : Partitions) {
+		auto consider = [&](const string& original, bool is_mount) {
+			string candidate = original;
+			while (candidate.size() > 1 && candidate.back() == '/')
+				candidate.pop_back();
+			size_t length = candidate.size();
+			if (!length || candidate[0] != '/')
+				return;
+			bool matches = query == candidate || (length > 1 && query.size() > length &&
+				query.compare(0, length, candidate) == 0 && query[length] == '/');
+			if (matches && (length > best_length ||
+				(length == best_length && is_mount && !best_is_mount))) {
+				best = part;
+				best_length = length;
+				best_is_mount = is_mount;
+				if (Matched_Path)
+					*Matched_Path = original;
+			}
+		};
+		consider(part->Mount_Point, true);
+		consider(part->Symlink_Mount_Point, false);
+	}
+	return best;
+}
