+bool TWPartitionManager::Update_Logical_Alias(TWPartition* Part, const string& Device) {
+	string source = Logical_Partition_Name(Part, false);
+	if (source.empty())
+		return false;
+	string path = "/dev/block/bootdevice/by-name/" + source;
+	if (!Part->Logical_Alias_Target.empty()) {
+		char target[4096];
+		ssize_t length = readlink(path.c_str(), target, sizeof(target));
+		if (length >= 0 && string(target, length) == Part->Logical_Alias_Target) {
+			if (!Device.empty() && Device == Part->Logical_Alias_Target)
+				return true;
+			if (unlink(path.c_str()) != 0)
+				return false;
+		} else if (length >= 0 || errno != ENOENT) {
+			// The entry was replaced externally. Never remove a foreign link/node.
+			Part->Logical_Alias_Target.clear();
+			return true;
+		}
+		Part->Logical_Alias_Target.clear();
+	}
+	struct stat st;
+	if (!Device.empty() && lstat(path.c_str(), &st) != 0 && errno == ENOENT) {
+		if (symlink(Device.c_str(), path.c_str()) != 0)
+			return false;
+		Part->Logical_Alias_Target = Device;
+		property_set("twrp.super.symlinks_created", "true");
+	}
+	return true;
+}
