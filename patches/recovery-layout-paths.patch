+string TWPartitionManager::Logical_Partition_Name(const TWPartition* Part, bool With_Slot) {
+	string name = TWFunc::Get_Filename(Part->Logical_Partition_Source);
+	if (name.empty() || name == "." || name == ".." ||
+		name.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-") != string::npos)
+		return "";
+#ifdef AB_OTA_UPDATER
+	bool explicit_slot = name.size() > 2 &&
+		(name.compare(name.size() - 2, 2, "_a") == 0 || name.compare(name.size() - 2, 2, "_b") == 0);
+	if (With_Slot && Part->SlotSelect && !explicit_slot) {
+		string suffix = Get_Active_Slot_Suffix();
+		if (suffix != "_a" && suffix != "_b")
+			return "";
+		name += suffix;
+	}
+#else
+	(void)With_Slot;
+#endif
+	return name.size() <= 36 ? name : "";
+}
