+bool TWPartitionManager::Validate_Backup_Restore_List(const string& List, bool Restore,
+	std::map<string, TWPartition*>* Plan) {
+	Plan->clear();
+	if (List.empty() || List.back() != ';') {
+		gui_err("invalid_backup_selection=Invalid or empty backup/restore selection.");
+		return false;
+	}
+	std::set<TWPartition*> seen;
+	std::set<dev_t> devices;
+	auto validate = [&](TWPartition* part) {
+		if (!part || !part->Is_Present || !seen.insert(part).second ||
+			(!Restore && !part->Can_Be_Backed_Up) || (Restore && part->Mount_Read_Only) ||
+			(part->Backup_Method != BM_FILES && part->Backup_Method != BM_DD &&
+			 part->Backup_Method != BM_FLASH_UTILS))
+			return false;
+		struct stat st;
+		if (stat(part->Actual_Block_Device.c_str(), &st) != 0 || !S_ISBLK(st.st_mode))
+			return false;
+		// android_secure is an intentional file subtree on its parent's device.
+		if (!part->Has_Android_Secure && !devices.insert(st.st_rdev).second)
+			return false;
+		if (part->Mount_Point == "/data" && DataManager::GetIntValue(TW_IS_FBE)) {
+			if (!part->Is_Decrypted || Users_List.empty())
+				return false;
+			bool owner_found = false;
+			for (const auto& user : Users_List) {
+				if (!user.isDecrypted)
+					return false;
+				owner_found |= user.userId == "0";
+			}
+			if (!owner_found)
+				return false;
+		}
+		return true;
+	};
+	size_t start = 0;
+	while (start < List.size()) {
+		size_t end = List.find(';', start);
+		string path = List.substr(start, end - start);
+		TWPartition* part = Find_Partition_By_Root_Path(path);
+		if (!part || path.empty() || part->Is_SubPartition ||
+			(path != part->Mount_Point && path != part->Backup_Path &&
+			 path != part->Symlink_Mount_Point &&
+			 !(path == "/system" && part->Mount_Point == Get_Android_Root_Path())) || !validate(part)) {
+			gui_msg(Msg(msg::kError, "invalid_backup_target=Unsupported, duplicate, unavailable or locked target '{1}'.")(path));
+			Plan->clear();
+			return false;
+		}
+		if (part->Has_SubPartition) {
+			for (auto* child : Partitions) {
+				if (child->Is_SubPartition && child->SubPartition_Of == part->Mount_Point &&
+					(Restore || child->Can_Be_Backed_Up) && !validate(child)) {
+					gui_msg(Msg(msg::kError, "invalid_backup_target=Unsupported, duplicate, unavailable or locked target '{1}'.")(child->Mount_Point));
+					Plan->clear();
+					return false;
+				}
+			}
+		}
+		Plan->emplace(path, part);
+		start = end + 1;
+	}
+	return !Plan->empty();
+}
+
+bool TWPartitionManager::Validate_Restore_Files(const std::map<string, TWPartition*>& Plan,
+	const string& Folder) {
+	auto validate = [&](TWPartition* part) {
+		const string& name = part->Backup_FileName;
+		if (name.empty() || name == "." || name == ".." || name.find_first_of("/\\") != string::npos)
+			return false;
+		PartitionSettings settings;
+		settings.Backup_Folder = Folder;
+		string type = part->Get_Restore_File_System(&settings);
+		if (!part->Is_File_System(type) && !part->Is_Image(type))
+			return false;
+		string path = Folder + "/" + name;
+		struct stat st;
+		if (lstat(path.c_str(), &st) != 0) {
+			if (errno != ENOENT || lstat((path + "000").c_str(), &st) != 0)
+				return false;
+		}
+		return S_ISREG(st.st_mode) && st.st_size > 0 && part->Validate_Restore_Archive(Folder);
+	};
+	for (const auto& selected : Plan) {
+		TWPartition* part = selected.second;
+		if (!validate(part))
+			return false;
+		if (part->Has_SubPartition) {
+			for (auto* child : Partitions) {
+				if (child->Is_SubPartition && child->SubPartition_Of == part->Mount_Point && !validate(child))
+					return false;
+			}
+		}
+	}
+	return true;
 }
 
