+// Android bind/overlay rows describe views, not block-backed Recovery partitions.
+// Keep their original first-stage fstab untouched; do not turn them into extra FS flags.
+static bool Recovery_Fstab_View(const char* line) {
+	std::istringstream input(line);
+	std::string source, target, type, options;
+	if (!(input >> source >> target >> type >> options))
+		return false;
+	bool bind_view = type == "none" && !source.empty() && source[0] == '/' &&
+		("," + options + ",").find(",bind,") != std::string::npos;
+	bool overlay_view = source == "overlay" && type == "overlay";
+	if ((bind_view || overlay_view) && !target.empty() && target[0] == '/') {
+		LOGINFO("Skipping Android %s view '%s' -> '%s' in Recovery partition parser\n",
+			bind_view ? "bind" : "overlay", source.c_str(), target.c_str());
+		return true;
+	}
+	return false;
+}
